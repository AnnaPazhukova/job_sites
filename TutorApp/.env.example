# Copy to .env.local for local development against a real Supabase project.
# Without these, the app falls back to browser-local storage (no login needed).
#
# Find both values in the Supabase dashboard: Project Settings -> API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: read-only Google Calendar sync on the Schedule page.
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console
# with this app's origin listed under Authorized JavaScript origins.
# Without this, the Google Calendar button simply doesn't appear.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
